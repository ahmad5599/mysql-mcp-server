{
  "name": "mysql-mcp-extension",
  "displayName": "MySQL MCP Extension",
  "description": "A VS Code extension for interacting with MySQL, PostgreSQL, and SQLite via MCP",
  "version": "0.0.1",
  "publisher": "ahmad5599",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mysql-mcp.configure"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mysql-mcp.configure",
        "title": "Configure MySQL MCP Server"
      }
    ]
  },
  "scripts": {
    "build": "echo 'No build required for JS extension'",
    "package": "vsce package --out mysql-mcp-extension.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "vscode-jsonrpc": "^8.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "pg": "^8.16.3",
    "pg-format": "^1.0.4",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "yargs": "^17.7.2"
  }
}