{
  "name": "sql-mcp-extension",
  "displayName": "SQL MCP - Database Query Assistant",
  "description": "Enable AI assistants to query MySQL, MariaDB, PostgreSQL, and SQLite databases using Model Context Protocol",
  "version": "1.0.0",
  "publisher": "ahmad5599",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Data Science",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "sql",
    "mysql",
    "postgresql",
    "sqlite",
    "database",
    "mcp",
    "ai",
    "copilot",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmad5599/mysql-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ahmad5599/mysql-mcp-server/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mysql-mcp.configure",
        "title": "Configure SQL MCP Connection"
      },
      {
        "command": "mysql-mcp.showStatus",
        "title": "Show SQL MCP Status"
      }
    ]
  },
  "scripts": {
    "build": "echo 'No build required for JS extension'",
    "package": "vsce package --out mysql-mcp-extension.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "mysql-mcp-server": "file:../mysql-mcp-server-1.0.0.tgz"
  }
}